# TLS'ni 1.2 dan yuqoriga chiqarmaslik. Mosquitto'ning tls_version sozlamasi
# faqat MINIMAL versiyani belgilaydi, maksimumni esa OpenSSL shu fayldan oladi.
# O'zbekistondan TLS 1.3 bilan handshake o'tadi, lekin keyingi ma'lumot
# qaytib kelmaydi (2026-10-19 sinovi); TLS 1.2 bilan darhol ishlaydi.
openssl_conf = default_conf

[default_conf]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MaxProtocol = TLSv1.2
